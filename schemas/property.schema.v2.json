{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://property-solar.local/schemas/property.schema.v2.json",
  "title": "Property Solar Viewer configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "location", "assets", "model", "scene"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 2},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "revision"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "description": {"type": "string", "maxLength": 500}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "timeZone", "displayLabel", "precision"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timeZone": {"type": "string", "minLength": 1, "maxLength": 120},
        "displayLabel": {"type": "string", "minLength": 1, "maxLength": 120},
        "precision": {"enum": ["exact", "rounded", "regional"]}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "url", "size", "integrity"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "type": {"enum": ["model", "thumbnail", "texture", "data"]},
          "url": {"type": "string", "minLength": 1, "maxLength": 2048},
          "size": {"type": "integer", "minimum": 0},
          "integrity": {
            "type": "string",
            "pattern": "^(sha256|sha384|sha512)-[A-Za-z0-9+/]+={0,2}$"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId"],
      "properties": {
        "assetId": {"$ref": "#/$defs/slug"},
        "units": {"enum": ["meters", "feet", "centimeters", "millimeters"]},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "northOffsetDegrees": {"type": "number", "minimum": -360, "maximum": 360},
        "position": {"$ref": "#/$defs/vector3"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groundBounds"],
      "properties": {
        "groundBounds": {"$ref": "#/$defs/groundBounds"},
        "terrainProfile": {
          "type": "array",
          "items": {"$ref": "#/$defs/terrainPoint"}
        },
        "cameraPresets": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"$ref": "#/$defs/cameraPreset"}
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {"$ref": "#/$defs/zone"}
    },
    "solar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultDate": {
          "anyOf": [
            {"const": "today"},
            {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          ]
        },
        "samplingMinutes": {"type": "integer", "minimum": 1, "maximum": 120},
        "exposureMethod": {"enum": ["estimated", "raycast"]},
        "features": {"$ref": "#/$defs/solarFeatures"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {"enum": ["private", "unlisted", "public"]},
        "showExactLocation": {"type": "boolean"},
        "showAddress": {"type": "boolean"}
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {"$ref": "#/$defs/theme"}
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "vector2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "groundBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minX", "maxX", "minZ", "maxZ"],
      "properties": {
        "minX": {"type": "number"},
        "maxX": {"type": "number"},
        "minZ": {"type": "number"},
        "maxZ": {"type": "number"}
      }
    },
    "terrainPoint": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "cameraPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "position": {"$ref": "#/$defs/vector3"},
        "target": {"$ref": "#/$defs/vector3"}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "anyOf": [
        {"required": ["position"]},
        {"required": ["geometry"]}
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "purpose": {"enum": ["general", "garden", "patio", "window", "pv"]},
        "surface": {"type": "string", "minLength": 1, "maxLength": 64},
        "elevation": {"type": "number"},
        "position": {
          "$ref": "#/$defs/vector3",
          "description": "Compatibility/representative [x, elevation, z] point."
        },
        "geometry": {"$ref": "#/$defs/zoneGeometry"},
        "sunlightThresholds": {"$ref": "#/$defs/sunlightThresholds"}
      }
    },
    "zoneGeometry": {
      "oneOf": [
        {"$ref": "#/$defs/pointGeometry"},
        {"$ref": "#/$defs/rectangleGeometry"},
        {"$ref": "#/$defs/polygonGeometry"}
      ]
    },
    "pointGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "z"],
      "properties": {
        "type": {"const": "point"},
        "x": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "rectangleGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minX", "maxX", "minZ", "maxZ"],
      "properties": {
        "type": {"const": "rectangle"},
        "minX": {"type": "number"},
        "maxX": {"type": "number"},
        "minZ": {"type": "number"},
        "maxZ": {"type": "number"}
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "vertices"],
      "properties": {
        "type": {"const": "polygon"},
        "vertices": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/vector2"}
        }
      }
    },
    "sunlightThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumDailyHours": {"type": "number", "minimum": 0, "maximum": 24},
        "preferredTimeWindow": {"$ref": "#/$defs/timeWindow"}
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
        "end": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"}
      }
    },
    "solarFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sunPath": {"type": "boolean"},
        "sunMap": {"type": "boolean"},
        "compass": {"type": "boolean"},
        "timelapse": {"type": "boolean"},
        "annualStudy": {"type": "boolean"}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["auto", "light", "dark"]},
        "accentColor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "skyStyle": {"enum": ["gradient", "solid"]}
      }
    }
  }
}
